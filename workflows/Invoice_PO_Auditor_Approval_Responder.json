        }
      }
    },
    {
      "id": "ff5f47d5-f66b-48ca-a490-68eb4edf6690",
      "name": "Prepare Pending Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "jsCode": "const p = $('Find Pending Approval').first().json;\nconst row = $input.first().json;\nreturn [{ json: {\n  id: p.id,\n  invoice_number: String(row.invoice_number ?? ''),\n  status: String(row.status ?? ''),\n  decided_at: String(row.processed_at ?? new Date().toISOString()),\n  reviewer_id: String(row.reviewer_id ?? '')\n}}];"
      }
    },
    {
      "id": "046f9471-437a-44e4-af3e-3af6167045aa",
      "name": "Mark Pending Decided",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_PENDING_APPROVALS_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": null
        }
      }
    },
    {
      "id": "562ff881-327d-4c56-af6c-4adb4de0c43c",
      "name": "Confirm to Charles",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ 'Invoice ' + $json.invoice_number + ' has been ' + ($json.status === 'APPROVED_MANUAL' ? 'approved' : 'rejected') + ' and recorded as ' + $json.status + '.' }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram - Demo Approvals"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "3b5c1048-86ec-4e97-a009-74fb2618dd21",
      "name": "Notify Submitter (HITL)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2400,
        300
      ],
      "parameters": {}
    }
  ],
