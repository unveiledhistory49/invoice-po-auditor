{
  "id": "invoice-po-auditor-approval-responder",
  "name": "Invoice_PO_Auditor_Approval_Responder",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "invoice-po-auditor-error-handler"
  },
  "nodes": [
    {
      "id": "74a79d86-607b-4376-b106-dc1fcea48cc7",
      "name": "On Approval Reply",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "telegram-approval-reply",
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-approval-reply",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "42cfbedd-1a86-4c05-b4ac-49d053b7d513",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst msg = body.message || {};\nconst text = String(msg.text || '');\nconst from = msg.from || {};\nconst chat = msg.chat || {};\nconst isApprove = /\\bapprove\\b/i.test(text);\nconst isReject = /\\b(reject|disapprove|deny)\\b/i.test(text);\nif (!isApprove && !isReject) return [];\nconst invMatch = text.match(/INV-\\d{4}-\\d+/i);\nif (!invMatch) return [];\nconst reviewer = String(from.username || from.id || from.first_name || 'telegram_reviewer');\nreturn [{ json: {\n  decision: isApprove ? 'APPROVE' : 'REJECT',\n  invoice_number: invMatch[0].toUpperCase(),\n  reviewer_id: reviewer,\n  chat_id: String(chat.id || ''),\n  message_text: text\n}}];"
      }
    },
    {
      "id": "9c75e8d0-0af5-42f7-b624-1823db1d1165",
      "name": "Fetch Pending Approvals",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_PENDING_APPROVALS_TABLE_ID"
        },
        "returnAll": true
      }
    },
    {
      "id": "2edf402f-a3d9-4306-9394-8d4d717d71a9",
      "name": "Find Pending Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const parsed = $('Parse Reply').first().json;\nconst rows = $input.all().map((i) => i.json);\nconst target = parsed.invoice_number.toUpperCase();\nconst pending = rows\n  .filter((r) => String(r.invoice_number || '').toUpperCase() === target && String(r.status || '').toUpperCase() === 'PENDING')\n  .sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));\nif (pending.length === 0) return [];\nconst row = pending[0];\nreturn [{ json: { ...row, decision: parsed.decision, reviewer_id: parsed.reviewer_id, chat_id: parsed.chat_id } }];"
      }
    },
    {
      "id": "d31ab42f-d78b-4c4e-b874-c5e2c7fec10c",
      "name": "Route by Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-responder-approved",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "APPROVE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9431db43-27a3-44b4-b837-4c446b149238",
      "name": "Prepare Approved Manual Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        140
      ],
      "parameters": {
        "jsCode": "const p = $('Find Pending Approval').first().json;\nreturn [{ json: {\n  invoice_number: String(p.invoice_number ?? ''),\n  vendor_name: String(p.vendor_name ?? ''),\n  po_number: String(p.po_number ?? ''),\n  invoice_date: String(p.invoice_date ?? ''),\n  currency: String(p.currency ?? ''),\n  stated_total: Number(p.stated_total ?? 0),\n  computed_total: Number(p.computed_total ?? 0),\n  po_variance: Number(p.po_variance ?? 0),\n  status: 'APPROVED_MANUAL',\n  reviewer_id: String(p.reviewer_id ?? 'telegram_reviewer'),\n  file_hash: String(p.file_hash ?? ''),\n  submitter_email: String(p.submitter_email ?? ''),\n  flags_json: String(p.flags_json ?? '[]'),\n  processed_at: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "b10aec0f-ea70-476e-8697-216fd8d2f449",
      "name": "Write Approved Manual Ledger",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1440,
        140
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_APPROVED_LEDGER_TABLE_ID"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": null
        }
      }
    },
    {
      "id": "5ee2cf58-b993-4a5c-93f4-d2e87bf26210",
      "name": "Prepare Rejected Manual Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        460
      ],
      "parameters": {
        "jsCode": "const p = $('Find Pending Approval').first().json;\nreturn [{ json: {\n  invoice_number: String(p.invoice_number ?? ''),\n  vendor_name: String(p.vendor_name ?? ''),\n  po_number: String(p.po_number ?? ''),\n  invoice_date: String(p.invoice_date ?? ''),\n  currency: String(p.currency ?? ''),\n  stated_total: Number(p.stated_total ?? 0),\n  computed_total: Number(p.computed_total ?? 0),\n  po_variance: Number(p.po_variance ?? 0),\n  status: 'REJECTED_MANUAL',\n  reviewer_id: String(p.reviewer_id ?? 'telegram_reviewer'),\n  file_hash: String(p.file_hash ?? ''),\n  submitter_email: String(p.submitter_email ?? ''),\n  flags_json: String(p.flags_json ?? '[]'),\n  processed_at: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "ef20da03-90f9-42d5-ba0f-2e2d91f822cf",
      "name": "Write Rejected Manual Ledger",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1440,
        460
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_APPROVED_LEDGER_TABLE_ID"
        },
